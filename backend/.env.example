# 代码加固平台 - 环境变量配置模板
# 复制本文件为 .env 并填写真实值

# 应用配置
APP_NAME=CodeHardening
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:ReplaceWithYourOwn32CharSecretKey!!
APP_URL=https://hardening.example.com
APP_TIMEZONE=Asia/Shanghai

# 数据库配置
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=code_hardening
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PREFIX=

# Redis缓存配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_DRIVER=redis

# JWT配置
JWT_SECRET=PleaseChangeThisToARandomSecureString
JWT_ACCESS_TTL=604800
JWT_REFRESH_TTL=2592000
JWT_ALG=HS256

# 加固配置
HARDENING_MAX_FILE_SIZE=10485760
HARDENING_TEMP_DIR=/tmp/hardening
HARDENING_ENCRYPT_KEY=ChangeMeToRandomKey32Bytes

# 上传配置
UPLOAD_MAX_SIZE=10485760
UPLOAD_SAVE_PATH=/data/uploads

# 频率限制
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_UPLOAD=10

# 审计日志
AUDIT_LOG_ENABLED=true
AUDIT_LOG_KEEP_DAYS=90
